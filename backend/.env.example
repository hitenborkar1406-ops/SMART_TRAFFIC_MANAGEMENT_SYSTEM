# Environment Variables for Smart Traffic Management System (Nagpur City)
# Configure these variables to connect live Google Maps or external Traffic APIs

PORT=8000
ENVIRONMENT=development

# Map Provider: "openstreetmap" (default open-source) or "googlemaps"
MAP_PROVIDER=openstreetmap

# Optional Google Maps API Key (if using Option A)
# Leave blank to use OpenStreetMap + Leaflet + OSRM (Option B - zero credentials required)
GOOGLE_MAPS_API_KEY=

# Traffic Data Provider: "simulation" (default for prototype) or "live"
TRAFFIC_DATA_SOURCE=simulation
LIVE_TRAFFIC_API_KEY=
